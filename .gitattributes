# 自动检测文本文件并统一使用 LF。
* text=auto eol=lf

# 以下文本文件始终使用 LF。
*.java text eol=lf
*.kt text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jar binary
*.ogg binary
